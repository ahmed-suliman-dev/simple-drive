# Copy this file to .env and adjust. Only the settings for the backend you
# choose are required.

# Which backend new blobs go to: database | local | s3 | ftp
STORAGE_BACKEND=database

# --- local -------------------------------------------------------------------
LOCAL_STORAGE_PATH=storage/blobs

# --- s3 (values below match docker-compose.yml's MinIO) -----------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=simple-drive
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- ftp (values below match docker-compose.yml's FTP server) -----------------
FTP_HOST=localhost
FTP_PORT=21
FTP_USERNAME=ftpuser
FTP_PASSWORD=ftppass
FTP_DIRECTORY=simple-drive
FTP_PASSIVE=true
